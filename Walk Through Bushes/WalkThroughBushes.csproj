<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>WalkThroughBushes</AssemblyName>
    <RootNamespace>WalkThroughBushes</RootNamespace>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Resolution order: explicit -p:GameDir, GYK2_GAME_DIR, then common Steam locations. -->
    <GameDir Condition="'$(GameDir)' == '' and '$(GYK2_GAME_DIR)' != ''">$(GYK2_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('C:/Steam/steamapps/common/Graveyard Keeper 2/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll')">C:/Steam/steamapps/common/Graveyard Keeper 2</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('C:/Steam/steamapps/common/Graveyard Keeper/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll')">C:/Steam/steamapps/common/Graveyard Keeper</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('$(ProgramFiles(x86))/Steam/steamapps/common/Graveyard Keeper 2/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll')">$(ProgramFiles(x86))/Steam/steamapps/common/Graveyard Keeper 2</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('$(ProgramFiles(x86))/Steam/steamapps/common/Graveyard Keeper/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll')">$(ProgramFiles(x86))/Steam/steamapps/common/Graveyard Keeper</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('$(ProgramFiles)/Steam/steamapps/common/Graveyard Keeper 2/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll')">$(ProgramFiles)/Steam/steamapps/common/Graveyard Keeper 2</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('$(ProgramFiles)/Steam/steamapps/common/Graveyard Keeper/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll')">$(ProgramFiles)/Steam/steamapps/common/Graveyard Keeper</GameDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == '' and '$(GameDir)' != ''">$(GameDir)/GraveyardKeeper2_Data/Managed</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == '' and '$(GameDir)' != ''">$(GameDir)/BepInEx/core</BepInExCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WalkThroughBushesPlugin.cs" />
    <Compile Include="BushRules.cs" />
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(GameManagedDir)/LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameManagedDir)' == '' or '$(BepInExCoreDir)' == ''"
           Text="Graveyard Keeper 2 was not found. Set GYK2_GAME_DIR or build with -p:GameDir=&quot;C:\path\to\Graveyard Keeper 2&quot;." />
    <ItemGroup>
      <MissingReference Include="@(Reference)" Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" />
    </ItemGroup>
    <Error Condition="'@(MissingReference)' != ''" Text="Missing local build references: @(MissingReference->'%(HintPath)', ', '). Confirm BepInEx is installed in the selected Graveyard Keeper 2 folder." />
  </Target>
</Project>
